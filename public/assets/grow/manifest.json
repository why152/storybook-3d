{
  "scene": "grow",
  "version": 1,
  "artboard": {
    "width": 1200,
    "height": 700,
    "ratio": "12:7"
  },
  "theme": "A forest is a place where little efforts become growth",
  "palette": [
    "#1D4D42",
    "#629679",
    "#D6D8A6",
    "#F4E9C7"
  ],
  "visualStory": "Rabbit climbs a ladder and reaches for leafy branches while a fox waters a new seedling, all around oversized paper-cut GROW letters.",
  "provenance": "Original SVG artwork created for this project; no original-site assets embedded.",
  "layers": [
    {
      "id": "background",
      "depth": 0,
      "opaque": true,
      "role": "palette, atmospheric light, distant setting",
      "motion": "fixed",
      "file": "background.svg",
      "transparent": false
    },
    {
      "id": "midground",
      "depth": 11,
      "role": "architecture, canopy, set dressing",
      "motion": "stagger-entrance + mouse-depth",
      "file": "midground.svg",
      "transparent": true
    },
    {
      "id": "lettering",
      "depth": 27,
      "role": "illustrated display typography",
      "motion": "stagger-entrance + mouse-depth",
      "file": "lettering.svg",
      "transparent": true
    },
    {
      "id": "characters",
      "depth": 48,
      "role": "character gestures and story action",
      "motion": "stagger-entrance + mouse-depth",
      "file": "characters.svg",
      "transparent": true
    },
    {
      "id": "foreground",
      "depth": 68,
      "role": "close-range framing and key story props",
      "motion": "stagger-entrance + mouse-depth",
      "file": "foreground.svg",
      "transparent": true
    },
    {
      "id": "effects",
      "depth": 78,
      "role": "independent airborne particles and embellishments",
      "motion": "ambient-float",
      "file": "effects.svg",
      "transparent": true
    }
  ],
  "renderer": "src/components/SceneArt.tsx (registered separate actor sprites on stationary book pages)",
  "motion": "Each actor has separate subtle story-specific CSS motion. Book-turn faces and reduced-motion users show still art. Original characters.svg remains unchanged as reference and WebGL atlas input.",
  "note": "Each layer covers a full transparent 1200×700 canvas; preserve alignment when editing. Text personalization is real HTML outside SVG.",
  "actors": [
    {
      "id": "rabbit",
      "file": "actors/rabbit.svg",
      "artboard": "0 0 1200 700",
      "pivot": "torso-left",
      "motion": "grow-rabbit-independent"
    },
    {
      "id": "fox",
      "file": "actors/fox.svg",
      "artboard": "0 0 1200 700",
      "pivot": "torso-right",
      "motion": "grow-fox-independent"
    },
    {
      "id": "props",
      "file": "actors/props.svg",
      "artboard": "0 0 1200 700",
      "pivot": "watering-can",
      "motion": "shared-watering-prop"
    }
  ]
}
