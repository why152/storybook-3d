{
  "name": "storybook-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:assets": "node scripts/verify-assets.mjs",
    "test:actors": "node scripts/extract-actors.mjs --check",
    "art:actors": "node scripts/extract-actors.mjs --write",
    "qa:local": "npm run test:actors && npm run test:assets && npm run lint && npm run typecheck && npm run build && npm run test:e2e && npm run qa:gallery",
    "qa:baseline": "playwright test tests/readiness.spec.ts",
    "qa:gallery": "node scripts/build-review-gallery.mjs test-results",
    "qa:browser:setup": "playwright install chromium"
  },
  "dependencies": {
    "gsap": "^3.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.0",
    "@playwright/test": "^1.56.0"
  }
}
