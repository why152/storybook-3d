{
  "id": "stargazer",
  "version": "v1",
  "title": "给追星的你",
  "subtitle": "一份来自屋顶的夜空地图",
  "author": "阿舟",
  "cover": "cover.webp",
  "music": "off",
  "spreads": {
    "hello": {
      "word": "邀请",
      "left": {
        "kicker": "给小禾",
        "lines": [
          "借你一张今晚的夜空地图。",
          "第一站就在旧屋顶。"
        ]
      },
      "right": {
        "kicker": "第一颗星",
        "lines": [
          "把头抬高一点点。",
          "看见树梢上那颗亮星了吗？"
        ],
        "photo": {
          "file": "keepsake.webp",
          "alt": "插画：屋顶望去的星空"
        }
      }
    },
    "grow": {
      "word": "准备",
      "left": {
        "kicker": "一把梯子",
        "lines": [
          "望远镜已经擦干净了。",
          "我还带了一条厚毯子。"
        ]
      },
      "right": {
        "kicker": "往上爬",
        "lines": [
          "走到最高一级，",
          "城里的灯就变成了河。"
        ]
      }
    },
    "together": {
      "word": "作伴",
      "left": {
        "kicker": "同一片天",
        "lines": [
          "我们相隔两座山。",
          "看到的是同一个月亮。"
        ]
      },
      "right": {
        "kicker": "在你那边",
        "lines": [
          "找个能望见天空的窗口。",
          "这一页也可以在那里读。"
        ]
      }
    },
    "dream": {
      "word": "辨星",
      "left": {
        "kicker": "月牙作路标",
        "lines": [
          "先认出那弯细细的月牙。",
          "然后朝它的右边数三颗。"
        ]
      },
      "right": {
        "kicker": "悄悄许愿",
        "lines": [
          "给那个还在长大的愿望，",
          "留一小块干净的夜空。"
        ]
      }
    },
    "wish": {
      "word": "再会",
      "left": {
        "kicker": "云来了",
        "lines": [
          "云盖住了天上的光。",
          "我想星星也该休息了。"
        ]
      },
      "right": {
        "kicker": "明晚见",
        "lines": [
          "等天气好转时，",
          "我们再从第一颗星找起。"
        ],
        "signature": "阿舟"
      }
    }
  }
}
