{
  "id": "afterglow",
  "version": "v1",
  "title": "晚风来信",
  "subtitle": "写给一起等日落的人",
  "author": "小满",
  "cover": "cover.webp",
  "music": "default",
  "spreads": {
    "hello": {
      "word": "傍晚",
      "left": {
        "kicker": "给阿晴",
        "lines": [
          "今天的风带着一点橘子香。",
          "我想把傍晚寄给你。"
        ]
      },
      "right": {
        "kicker": "路上",
        "lines": [
          "经过那家亮着灯的小店。",
          "买了两块你喜欢的饼干。"
        ],
        "photo": {
          "file": "keepsake.webp",
          "alt": "插画：日落时的远山"
        }
      }
    },
    "grow": {
      "word": "种子",
      "left": {
        "kicker": "小小的愿望",
        "lines": [
          "春天埋下的那颗种子，",
          "今天长出了第二片叶子。"
        ]
      },
      "right": {
        "kicker": "慢慢长大",
        "lines": [
          "我每天给它一点水。",
          "也给自己一点耐心。"
        ]
      }
    },
    "together": {
      "word": "并肩",
      "left": {
        "kicker": "走慢一点",
        "lines": [
          "上次我们沿河往回走。",
          "脚步比夕阳还慢。"
        ]
      },
      "right": {
        "kicker": "留个位置",
        "lines": [
          "下回还坐那张长椅，",
          "靠树的位置留给你。"
        ]
      }
    },
    "dream": {
      "word": "起风",
      "left": {
        "kicker": "沿河的灯",
        "lines": [
          "晚风从桥下穿过去。",
          "一盏盏灯在水里发亮。"
        ]
      },
      "right": {
        "kicker": "晚风寄件",
        "lines": [
          "如果你也听见风，",
          "那就是我的问候。"
        ]
      }
    },
    "wish": {
      "word": "落款",
      "left": {
        "kicker": "等你回信",
        "lines": [
          "挑一个你喜欢的傍晚。",
          "把那天的颜色告诉我。"
        ]
      },
      "right": {
        "kicker": "下次见",
        "lines": [
          "愿我们总有空等一场日落。",
          "也有空坐下来聊聊天。"
        ],
        "signature": "小满"
      }
    }
  }
}
